# Frontend (React + Vite) — variables de entorno de desarrollo y build
# Solo vars alfabéticas y subrayado; Vite BLOQUEA variables que empiecen con VITE_.
# Renombrar/otorgar los valores reales en `frontend/.env` (no se commitea).

# Url base de la app sobre la que se sirve la SPA (npm run build, preview y proxy del backend)
VITE_APP_BASE_URL=/

# Frontend url de desarrollo (usada por algunos scripts de Helpers)
VITE_APP_URL=http://localhost:5173

# Turno por defecto en las capturas/prototipos
VITE_DEFAULT_TURN_ID=n/a
