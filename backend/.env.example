# Copiá este archivo a `.env` y completá los valores.
# En Render se defines directo en el panel (Environment), no hace falta el archivo.

# --- Correo (opcional) ---
# Sin estas dos variables la app funciona igual, pero los mails NO se envían:
# se guardan en la tabla `mails` y se imprimen en la consola como
# "[MAIL-SIMULADO]". Turnos confirmados, cancelados y recordatorios avisan
# al cliente por acá.
# Es una contraseña de aplicación de Google (no la contraseña de la cuenta),
# con los permisos de Gmail activados.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# MAIL_SIMULADO=1 fuerza el modo simulado aunque Gmail esté configurado:
# ideal para smoke tests y demos, así no se llena la casilla real.
# MAIL_SIMULADO=

# --- Base de datos ---
# Ruta del archivo SQLite. En Render tiene que apuntar al disco montado
# (ver `render.yaml`): /var/data/lubricentro.db
# Si no se define, usa backend/src/config/lubricentro.db dentro del proyecto.
DB_PATH=/var/data/lubricentro.db

# --- Servidor ---
# Puerto del servidor Express. Render lo inyecta solo; 3001 es el default.
PORT=3001
