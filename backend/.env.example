# Backend - Variables de Entorno (PostgreSQL + Prisma)
# Copiar este archivo a `backend/.env` para desarrollo local sin Docker

NODE_ENV=development
PORT=3000

# Conexión PostgreSQL:
# - Local con Docker: postgresql://postgres:postgres@localhost:5432/lubricentro_db
# - Nube con Neon (Recomendado gratuito): postgresql://user:pass@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
# - Nube con Render Postgres: postgresql://user:pass@dpg-xyz.oregon-postgres.render.com/lubricentro
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lubricentro_db

# Seguridad JWT
JWT_SECRET=super_secreto_jwt_sanjose_2026
JWT_EXPIRES_IN=24h
SALT_ROUNDS=10

# URL del Frontend (para CORS en producción / Vercel)
FRONTEND_URL=http://localhost:5173

# Envío de correos por Gmail (Opcional: sin credenciales funciona en modo simulado)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Credenciales administrador inicial
ADMIN_EMAIL=admin@sanjose.com
ADMIN_PASSWORD=admin123
