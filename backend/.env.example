# Backend - variables de entorno
# Copiar en `backend/.env` y rellenar las credenciales.
# El fichero `.env` nunca se sube a git (registra el .gitignore).

# Entorno
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:tu_password_segura@db:5432/hello_rubricentro_db

# Seguridad y Autenticación
JWT_SECRET=cambiame_por_una_cadena_secreta_segura_para_el_tp
JWT_EXPIRES_IN=24h
SALT_ROUNDS=10
FRONTEND_URL=http://localhost:5173

# Base de datos SQLite (opcional; por defecto se crea en backend/src/config/lubricentro.db)
# Para Render, apuntar a un disco montado persistente: DB_PATH=/var/data/lubricentro.db
DB_PATH=

# Correos (opcional; sin credenciales el envío se queda en simulado)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Administrador inicial
ADMIN_EMAIL=admin@sanjose.com
ADMIN_PASSWORD=admin123
