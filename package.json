{
  "name": "gestion-san-jose",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "api": "node backend/src/index.js",
    "dev:api": "npm run api",
    "dev:web": "npm --prefix frontend run dev",
    "dev:all": "concurrently \"npm run api\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix frontend run build",
    "start": "node backend/src/index.js",
    "test": "npm --prefix frontend run test",
    "smoke": "node frontend/scripts/api-smoke.mjs"
  },
  "dependencies": {
    "concurrently": "^10.0.5"
  }
}
